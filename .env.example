# Create a Telegram bot with @BotFather and put its token here.
BOT_TOKEN=123456:replace-with-your-botfather-token
# Numeric Telegram user IDs allowed to administer this bot. Comma-separated.
ADMIN_IDS=123456789
# Keep this directory on persistent storage in production.
DATABASE_PATH=data/kagex_vault.sqlite3
REFERRAL_POINTS=4
# Optional public support URL, e.g. https://t.me/your_support_group
SUPPORT_URL=
LOG_LEVEL=INFO
